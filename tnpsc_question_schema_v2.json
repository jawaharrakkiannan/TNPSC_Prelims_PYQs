{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tnpsc_question_schema_v2",
  "title": "TNPSC Group 1 Prelims — Universal Question Schema v2",
  "description": "Full-paper scan of 200 questions across 160 pages. All structural variants captured.",

  "changelog_from_v1": [
    "Added disputed flag (questions referred to expert committee — seen in red annotation)",
    "Added stem_has_blank flag (fill-in-blank stems with dash or underline)",
    "Added item_numbering_style to statement_mcq and chronological_order (roman/arabic/alpha)",
    "Added match_style to match_the_following (tabular vs inline)",
    "Added has_math flag and math_format field for algebraic/formula questions",
    "Added options_layout field (single_column vs two_column)",
    "Clarified AR options are always free text — no enum; text varies per question",
    "Media block already present in v1; confirmed needed for Q200 (cube diagrams)"
  ],

  "question_types_enum": [
    "simple_mcq",
    "statement_mcq",
    "match_the_following",
    "assertion_reason",
    "chronological_order"
  ],

  "top_level_fields": {
    "question_no":        "integer — serial number 1..200",
    "question_type":      "enum — one of question_types_enum",
    "subject":            "string — LLM-assigned subject tag",
    "topic":              "string — LLM-assigned finer topic",
    "paper_code":         "string — booklet code e.g. CCSEI-IAP25",
    "page_no":            "integer — PDF page where question starts",

    "disputed":           "boolean — true if red 'expert committee' annotation present on question",
    "stem_has_blank":     "boolean — true if stem contains a fill-in-the-blank gap (—— or _____)",
    "has_math":           "boolean — true if stem or any option contains mathematical notation",
    "math_format":        "enum|null — 'plain_text' | 'latex' | 'unicode' — how math is encoded after OCR",
    "options_layout":     "enum — 'single_column' (A B C D E stacked) | 'two_column' (A+B on row1, C+D on row2)",

    "media":              "array|null — see media_block_schema; null if no diagram/image",
    "en":                 "object — English language block",
    "ta":                 "object — Tamil language block (identical structure to en)",
    "answer_key":         "string|null — correct option key A/B/C/D/E; null until populated",
    "meta":               "object — pipeline metadata"
  },

  "language_block_fields_by_type": {

    "simple_mcq": {
      "stem":    "string — question text",
      "options": "array of {key: A|B|C|D|E, text: string}"
    },

    "statement_mcq": {
      "stem":                 "string — question text",
      "item_numbering_style": "enum — 'roman' (i/ii/iii/iv) | 'arabic' (1/2/3/4) | 'alpha' (a/b/c/d)",
      "statements":           "array of {no: string, text: string}",
      "options":              "array of {key: A|B|C|D|E, text: string}"
    },

    "match_the_following": {
      "stem":        "string — question text",
      "match_style": "enum — 'tabular' | 'inline'",

      "_tabular_note": "Used when left+right are separate columns with a matrix answer table. left_column uses a/b/c/d keys. right_column uses integer nos. Options store mapping objects.",
      "left_column":  "array of {key: string (a|b|c|d), text: string}",
      "right_column": "array of {no: integer, text: string}",
      "options": [
        "For keys A-D: {key: string, mapping: {a: int, b: int, c: int, d: int}}",
        "For key E: {key: 'E', text: 'Answer not known'}"
      ],

      "_inline_note": "Used when each numbered item already contains its own paired right-side value (dash-separated or colon). No matrix. Options refer to item numbers as text pairs.",
      "items":   "array of {no: string, text: string} — full pair text including the right side",
      "options": "array of {key: A|B|C|D|E, text: string} — e.g. '(1) and (3) are correct'"
    },

    "assertion_reason": {
      "assertion": "string — Assertion [A] text",
      "reason":    "string — Reason [R] text",
      "options":   "array of {key: A|B|C|D|E, text: string} — stored verbatim; text varies per question"
    },

    "chronological_order": {
      "stem":                 "string — question text",
      "item_numbering_style": "enum — 'roman' | 'arabic'",
      "items":                "array of {no: string, text: string}",
      "options":              "array of {key: A|B|C|D|E, text: string}"
    }
  },

  "media_block_schema": {
    "id":        "string — unique ID e.g. img_q200_cube",
    "type":      "enum — 'image' | 'diagram' | 'formula' | 'table'",
    "placement": "enum — 'shared_stem' | 'en_stem' | 'ta_stem' | 'en_options' | 'ta_options'",
    "path":      "string — relative path to extracted file e.g. media/q200_cube.png",
    "alt_text":  "string — plain-text description for accessibility"
  },

  "meta_block_schema": {
    "extraction_status": "enum — 'pending' | 'extracted' | 'verified'",
    "ocr_confidence":    "float|null — 0.0 to 1.0; set by OCR pipeline",
    "notes":             "string — free-form notes e.g. handwritten marks, smudges"
  },

